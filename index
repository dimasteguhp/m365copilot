<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Microsoft 365 Copilot untuk Tim Operations Meratus</title>
<style>
:root{
  --primary:#0B3D5C; --accent:#0E7C86;
  --bg:#F4F7FA; --surface:#FFFFFF; --surface2:#F8FAFC; --text:#1E293B; --muted:#64748B; --line:#E2E8F0;
  --word:#185ABD; --excel:#107C41; --powerpoint:#C43E1C; --outlook:#0F6CBD; --teams:#5B5FC7;
  --agent:#0E7C86; --chat:#7A3EC8; --loop:#7719AA; --challenge:#B45309; --general:#475569;
  --g:#2563EB; --c:#0D9488; --s:#D97706; --e:#9333EA;
  --radius:14px; --fs:16px; --side:290px;
}
[data-theme="dark"]{--bg:#0B1220;--surface:#111A2B;--surface2:#0F1726;--text:#E2E8F0;--muted:#94A3B8;--line:#22314A}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;font-size:var(--fs);line-height:1.6;background:var(--bg);color:var(--text)}
a{color:inherit}
/* ---------- topbar ---------- */
.topbar{position:fixed;top:0;left:0;right:0;height:62px;display:flex;align-items:center;gap:14px;padding:0 18px;
  background:var(--primary);color:#fff;z-index:50;box-shadow:0 2px 12px rgba(0,0,0,.18)}
.topbar .brand{font-weight:700;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;min-width:0}
.topbar .brand small{display:block;font-weight:400;opacity:.75;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase}
.prog{display:flex;align-items:center;gap:8px;font-size:13px;white-space:nowrap}
.prog .bar{width:140px;height:8px;border-radius:9px;background:rgba(255,255,255,.22);overflow:hidden}
.prog .bar i{display:block;height:100%;width:0;background:#5EEAD4;transition:width .4s}
.tbtn{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:9px;padding:7px 11px;
  font-size:13px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;font-family:inherit}
.tbtn:hover{background:rgba(255,255,255,.24)}
#menuBtn{display:none}
/* ---------- sidebar ---------- */
.side{position:fixed;top:62px;bottom:0;left:0;width:var(--side);background:var(--surface);border-right:1px solid var(--line);
  overflow-y:auto;padding:16px 12px 40px;z-index:40;transition:transform .25s}
.side h6{margin:6px 10px 10px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.nav-sec{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;text-decoration:none;font-size:14px;font-weight:600}
.nav-sec:hover,.nav-sec.active{background:var(--surface2)}
.nav-sec.active{box-shadow:inset 3px 0 0 var(--accent)}
.nav-sec .ic{width:26px;height:26px;border-radius:7px;display:grid;place-items:center;color:#fff;font-size:12px;font-weight:800;flex:none}
.nav-sec .cnt{margin-left:auto;font-size:11px;color:var(--muted);font-weight:600}
.nav-sec .cnt.done{color:#16A34A}
.nav-sub{display:block;padding:4px 10px 4px 46px;font-size:13px;color:var(--muted);text-decoration:none;border-radius:8px;position:relative}
.nav-sub:hover{color:var(--text);background:var(--surface2)}
.nav-sub.done::before{content:"✓";position:absolute;left:30px;color:#16A34A;font-weight:800}
/* ---------- main ---------- */
main{margin-left:var(--side);padding:86px 40px 80px;max-width:calc(var(--side) + 1060px)}
.hero{border-radius:22px;padding:38px 40px;color:#fff;position:relative;overflow:hidden;
  background:linear-gradient(135deg,var(--primary) 0%,var(--accent) 100%);margin-bottom:28px}
.hero::after{content:"";position:absolute;right:-80px;top:-80px;width:320px;height:320px;border-radius:50%;background:rgba(255,255,255,.08)}
.hero .eyebrow{font-size:12px;letter-spacing:.18em;font-weight:700;opacity:.85}
.hero h1{margin:8px 0 6px;font-size:2.0em;line-height:1.2}
.hero p{margin:0;opacity:.9;font-size:1.05em}
.hero .info{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:24px;position:relative;z-index:1}
.hero .info div{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:12px 14px;font-size:.88em}
.hero .info b{display:block;font-size:.78em;letter-spacing:.1em;text-transform:uppercase;opacity:.8;margin-bottom:3px}
.hero .var{background:rgba(255,255,255,.2);color:#fff;border-color:rgba(255,255,255,.4)}
.howto{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 26px}
.howto span{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-size:.82em;color:var(--muted)}
.howto b{color:var(--text)}
section.sec.is-done{border-color:#86EFAC}
section.sec{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:28px 32px;margin-bottom:26px}
.sec-head{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.sec-head .ic{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;color:#fff;font-weight:800;font-size:16px;flex:none}
.sec-head h2{margin:0;font-size:1.45em;color:var(--primary)}
[data-theme="dark"] .sec-head h2{color:#7DD3FC}
.sec-head .tag{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:700}
.sub{border:1px solid var(--line);border-radius:12px;margin-top:18px;background:var(--surface2);overflow:hidden}
.sub-head{display:flex;align-items:center;gap:12px;padding:14px 18px;cursor:pointer;user-select:none}
.sub-head h3{margin:0;font-size:1.08em;flex:1}
.sub-head .chev{transition:transform .2s;color:var(--muted)}
.sub.collapsed .chev{transform:rotate(-90deg)}
.sub.collapsed .sub-body{display:none}
.sub-body{padding:4px 20px 20px}
.done-toggle{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--muted);
  border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:4px 12px;cursor:pointer;font-family:inherit}
.done-toggle.on{background:#DCFCE7;color:#166534;border-color:#86EFAC}
.sub.is-done{border-color:#86EFAC}
.label{font-weight:700;color:var(--accent);margin:18px 0 6px;font-size:.95em;letter-spacing:.02em}
p{margin:8px 0}
ul,ol{margin:6px 0 10px;padding-left:22px}
ol.steps{list-style:none;padding:0;counter-reset:s}
ol.steps li{counter-increment:s;position:relative;padding:8px 12px 8px 46px;margin:6px 0;background:var(--surface);border:1px solid var(--line);border-radius:10px}
ol.steps li::before{content:counter(s);position:absolute;left:12px;top:8px;width:24px;height:24px;border-radius:50%;
  background:var(--accent);color:#fff;font-size:12px;font-weight:700;display:grid;place-items:center}
/* flow */
.flow{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:10px 0 14px}
.flow span.st{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--accent);padding:6px 12px;border-radius:9px;font-weight:600;font-size:.88em}
.flow .ar{color:var(--muted);font-weight:700}
/* tables */
.tbl-wrap{overflow-x:auto;margin:12px 0}
table{border-collapse:collapse;width:100%;font-size:.92em;background:var(--surface);border-radius:10px;overflow:hidden}
th{background:var(--primary);color:#fff;text-align:left;padding:10px 12px;font-weight:600}
td{padding:9px 12px;border-bottom:1px solid var(--line);vertical-align:top}
tr:last-child td{border-bottom:0}
tbody tr:nth-child(even) td{background:var(--surface2)}
table.kv td:first-child{width:200px;font-weight:700;color:var(--primary);background:var(--surface2)}
[data-theme="dark"] table.kv td:first-child{color:#7DD3FC}
table.kv{border:1px solid var(--line)}
/* callout */
.callout{border-radius:12px;padding:12px 16px 12px 46px;margin:14px 0;position:relative;font-size:.95em;border:1px solid}
.callout::before{position:absolute;left:14px;top:11px;font-size:18px}
.callout.result{background:#ECFDF5;border-color:#A7F3D0;color:#065F46}.callout.result::before{content:"🎯"}
.callout.warn{background:#FFFBEB;border-color:#FDE68A;color:#78350F}.callout.warn::before{content:"⚠️"}
.callout.info{background:#EFF6FF;border-color:#BFDBFE;color:#1E3A8A}.callout.info::before{content:"💡"}
[data-theme="dark"] .callout{filter:brightness(.92)}
/* prompt */
.prompt{border:1px solid var(--line);border-radius:14px;margin:14px 0;background:var(--surface);box-shadow:0 2px 10px rgba(15,23,42,.05);overflow:hidden}
.prompt-head{display:flex;align-items:center;gap:10px;padding:10px 14px;background:linear-gradient(90deg,var(--primary),var(--accent));color:#fff}
.prompt-head .pill{background:rgba(255,255,255,.2);font-size:10.5px;font-weight:800;letter-spacing:.14em;padding:3px 9px;border-radius:999px}
.prompt-head .ttl{font-weight:700;flex:1;font-size:.95em}
.copy{background:#fff;color:var(--primary);border:0;border-radius:8px;padding:6px 12px;font-weight:700;font-size:12.5px;cursor:pointer;font-family:inherit;display:inline-flex;gap:6px;align-items:center}
.copy:hover{filter:brightness(.95)}
.copy.ok{background:#22C55E;color:#fff}
.prompt-body{padding:14px 18px}
.part{display:grid;grid-template-columns:150px 1fr;gap:14px;padding:8px 0;border-bottom:1px dashed var(--line)}
.part:last-child{border-bottom:0}
.part .lb{font-size:11.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;align-self:start;
  display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:8px;color:#fff;width:max-content}
.part .lb i{font-style:normal;background:rgba(255,255,255,.3);border-radius:5px;padding:0 5px}
.lb.goal{background:var(--g)}.lb.context{background:var(--c)}.lb.source{background:var(--s)}.lb.expectations,.lb.expectation{background:var(--e)}
.part .tx{white-space:pre-wrap;font-size:.95em}
.part.nolabel{grid-template-columns:1fr}
.var{display:inline-block;background:#FEF3C7;color:#92400E;border:1px dashed #F59E0B;border-radius:6px;padding:0 5px;font-weight:600;font-size:.95em;cursor:pointer;line-height:1.45}
.var.filled{background:#DCFCE7;color:#166534;border:1px solid #4ADE80}
.var.file{background:#E0F2FE;color:#075985;border-color:#38BDF8}
.var.file.filled{background:#DCFCE7;color:#166534;border:1px solid #4ADE80}
/* drawer */
.drawer{position:fixed;top:62px;right:0;bottom:0;width:380px;max-width:100%;background:var(--surface);border-left:1px solid var(--line);
  z-index:60;transform:translateX(105%);transition:transform .25s;display:flex;flex-direction:column;box-shadow:-8px 0 30px rgba(0,0,0,.12)}
.drawer.open{transform:none}
.drawer header{padding:18px 20px 8px}
.drawer header h4{margin:0 0 4px;font-size:1.05em}
.drawer header p{margin:0;font-size:.84em;color:var(--muted)}
.drawer .list{overflow-y:auto;padding:8px 20px 20px;flex:1}
.drawer .grp{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700;margin:14px 0 6px}
.drawer label{display:block;font-size:.82em;font-weight:600;margin:10px 0 4px}
.drawer input{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:9px;font-size:.92em;background:var(--surface2);color:var(--text);font-family:inherit}
.drawer input:focus{outline:2px solid var(--accent);border-color:transparent}
.drawer footer{padding:12px 20px;border-top:1px solid var(--line);display:flex;gap:8px}
.btn{border:1px solid var(--line);background:var(--surface2);color:var(--text);padding:8px 14px;border-radius:9px;cursor:pointer;font-weight:600;font-size:.85em;font-family:inherit}
.btn.pri{background:var(--accent);color:#fff;border-color:transparent}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(30px);opacity:0;background:#0F172A;color:#fff;
  padding:10px 18px;border-radius:10px;font-size:14px;z-index:99;transition:.25s;pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%)}
.empty-vars{color:var(--muted);font-size:.9em}
footer.foot{text-align:center;color:var(--muted);font-size:.8em;margin-top:30px}
/* responsive + print */
@media(max-width:980px){
  .side{transform:translateX(-100%)} .side.open{transform:none;box-shadow:8px 0 30px rgba(0,0,0,.2)}
  main{margin-left:0;padding:80px 16px 60px} #menuBtn{display:inline-flex} .prog .bar{width:70px}
  .part{grid-template-columns:1fr;gap:6px} section.sec{padding:20px 18px} .hero{padding:28px 22px}
  .topbar .hide-sm{display:none}
}
@media print{
  .topbar,.side,.drawer,.copy,.done-toggle,.howto{display:none!important}
  main{margin:0;padding:0;max-width:none} body{background:#fff}
  .sub.collapsed .sub-body{display:block} section.sec,.prompt{break-inside:avoid-page}
  .hero{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
</head>
